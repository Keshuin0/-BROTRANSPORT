---
import CommandGlobe from './globe/CommandGlobe';
---

<section
  data-hero-stage
  class="relative overflow-hidden border-b border-white/[0.08] pt-4 pb-10 sm:pt-8 sm:pb-12 lg:pt-8 lg:pb-12 flex flex-col justify-between"
>
  <div class="relative flex flex-col lg:block lg:min-h-[600px] xl:min-h-[640px]">
    <!-- Right Atmospheric 3D Orbital Command Canvas (pinned cleanly at right-0 so HUD controls never clip) -->
    <div class="lg:absolute lg:top-0 lg:right-0 lg:w-[58%] xl:w-[57%] z-10 order-2 lg:order-none px-3 sm:px-6 lg:px-0 mt-6 lg:mt-0">
      <CommandGlobe client:load variant="hero" className="bro-hero-globe" />
    </div>

    <!-- Soft Editorial Readability Scrim (keeps left typography razor-sharp over WebGL limb) -->
    <div
      class="hidden lg:block absolute inset-y-0 left-0 w-[52%] bg-gradient-to-r from-[#020308] via-[#020308]/92 to-transparent pointer-events-none z-10"
      aria-hidden="true"
    ></div>

    <!-- Left Editorial Command Stage -->
    <div class="relative z-20 max-w-7xl mx-auto w-full px-4 sm:px-6 pt-2 sm:pt-4 lg:pt-8 order-1 lg:order-none pointer-events-none">
      <div class="max-w-xl space-y-5 sm:space-y-6 pointer-events-auto">
        <div class="inline-flex flex-wrap items-center gap-x-2.5 gap-y-1 px-3.5 py-1.5 rounded-2xl sm:rounded-full liquid-glass-pill text-xs font-medium text-slate-200 max-w-full">
          <span class="h-2 w-2 rounded-full bg-emerald-400 shrink-0" aria-hidden="true"></span>
          <span>North America Transborder Operating System</span>
          <span class="text-slate-300" aria-hidden="true">·</span>
          <span class="font-mono text-bro-cyan whitespace-nowrap">SCAC BROP</span>
        </div>

        <div class="space-y-3.5 sm:space-y-4">
          <h1 class="text-hero-fluid font-display font-bold text-white">
            Bold. Reliable. <br />
            <span class="bg-gradient-to-r from-white via-cyan-200 to-bro-cyan bg-clip-text text-transparent">
              Orchestrated.
            </span>
          </h1>
          <p class="text-sm sm:text-lg text-slate-300 leading-relaxed max-w-lg">
            Commercial Dry Van, Cold-Chain Reefer, and Open-Deck Flatbed logistics connecting Atlantic Canada and continental North America—on live CBP/CBSA border intelligence and cryptographic chain-of-custody.
          </p>
        </div>

        <!-- Focused Primary Action Bar (Porcelain White Primary + Glass Secondary) -->
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href="/quote"
            data-astro-prefetch
            class="min-h-[44px] inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-white text-black hover:bg-bro-cyan font-semibold text-sm tracking-tight shadow-[0_10px_30px_-8px_rgba(255,255,255,0.35)] transition-colors"
          >
            <span>Get Instant Lane Rate</span>
            <span aria-hidden="true">→</span>
          </a>

          <a
            href="/customs"
            data-astro-prefetch
            class="min-h-[44px] inline-flex items-center gap-2 px-5 py-3 rounded-full liquid-glass-pill text-white hover:border-white/30 text-sm font-medium transition-colors"
          >
            <span>Border &amp; CARM Pre-Flight</span>
          </a>
        </div>

        <!-- Clean Split-Path Portal Access Bar -->
        <div class="pt-2 space-y-2.5">
          <div class="text-xs font-medium text-slate-300">Direct Portal Access</div>
          <div class="flex flex-wrap items-center gap-2">
            <a
              href="/portal/shipper"
              data-astro-prefetch
              class="min-h-[44px] inline-flex items-center gap-2 px-3.5 py-2 rounded-xl surface-ceramic text-xs font-medium text-slate-200 hover:text-white hover:border-bro-cyan/40 transition-colors"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-bro-cyan" aria-hidden="true"></span>
              <span>Shipper Portal</span>
            </a>
            <a
              href="/portal/driver"
              data-astro-prefetch
              class="min-h-[44px] inline-flex items-center gap-2 px-3.5 py-2 rounded-xl surface-ceramic text-xs font-medium text-slate-200 hover:text-white hover:border-bro-gold/40 transition-colors"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-bro-gold" aria-hidden="true"></span>
              <span>Driver Offline PWA</span>
            </a>
            <a
              href="/ops"
              data-astro-prefetch
              class="min-h-[44px] inline-flex items-center gap-2 px-3.5 py-2 rounded-xl surface-ceramic text-xs font-medium text-slate-200 hover:text-white hover:border-white/30 transition-colors"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
              <span>Employee Ops Tower</span>
            </a>
            <a
              href="/verify"
              data-astro-prefetch
              class="min-h-[44px] inline-flex items-center gap-2 px-3.5 py-2 rounded-xl surface-ceramic text-xs font-medium text-slate-200 hover:text-white hover:border-bro-cyan/40 transition-colors"
            >
              <span>Verify eBOL</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quiet Full-Width Bottom Capability Architecture Strip (Safely separated below Globe HUD) -->
  <div class="relative z-20 max-w-7xl mx-auto w-full px-4 sm:px-6 pt-6 lg:pt-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 py-4 px-5 rounded-2xl surface-ceramic">
      <div>
        <div class="text-xs text-slate-300">Crossings Synced</div>
        <div class="mt-0.5 font-mono text-sm font-semibold text-white tabular-nums">13 US / CA Ports</div>
      </div>
      <div>
        <div class="text-xs text-slate-300">Cold-Chain Control</div>
        <div class="mt-0.5 font-mono text-sm font-semibold text-bro-cyan tabular-nums">-28°C to +25°C</div>
      </div>
      <div>
        <div class="text-xs text-slate-300">Digital Custody</div>
        <div class="mt-0.5 font-mono text-sm font-semibold text-white">ECDSA P-256</div>
      </div>
      <div>
        <div class="text-xs text-slate-300">Customs Protocol</div>
        <div class="mt-0.5 font-mono text-sm font-semibold text-bro-gold">ACE · ACI CARM R2</div>
      </div>
    </div>
  </div>
</section>

<style>
  :global(.bro-hero-globe) {
    height: 340px !important;
  }

  @media (min-width: 640px) {
    :global(.bro-hero-globe) {
      height: 460px !important;
    }
  }

  @media (min-width: 1024px) {
    :global(.bro-hero-globe) {
      height: 600px !important;
    }
  }

  @media (min-width: 1280px) {
    :global(.bro-hero-globe) {
      height: 640px !important;
    }
  }
</style>
