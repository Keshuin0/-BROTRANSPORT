---
import BroLogo from './brand/BroLogo.astro';
import CommandGlobe from './globe/CommandGlobe';
---

<section class="relative overflow-hidden border-b border-white/10 py-14 lg:py-20 px-4 sm:px-6">
  <div class="absolute top-0 left-1/4 w-[28rem] h-[28rem] bg-bro-gold/5 rounded-full blur-[130px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-0 right-1/4 w-[28rem] h-[28rem] bg-bro-cyan/5 rounded-full blur-[130px] pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
    <!-- Left Column: Brand Authority & Dual-Portal Entry -->
    <div class="lg:col-span-6 space-y-7">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-bro-cyan/30 bg-bro-steel/70 font-mono text-[10px] uppercase tracking-widest text-bro-cyan">
        <span class="h-1.5 w-1.5 rounded-full bg-bro-cyan"></span>
        <span>NORTH AMERICA TRANSBORDER LOGISTICS OS · SCAC BROP</span>
      </div>

      <BroLogo showSlogan />

      <div class="space-y-3">
        <h1 class="text-4xl sm:text-5xl xl:text-6xl font-display font-black uppercase tracking-tight leading-[1.02] text-white">
          BOLD. RELIABLE. <br />
          <span class="text-bro-cyan glow-text-cyan">ORCHESTRATED.</span>
        </h1>
        <p class="text-sm sm:text-base text-slate-300 max-w-xl leading-relaxed">
          Atlantic Canada to North America commercial Dry Van, Cold-Chain Reefer, and Open-Deck Flatbed freight—powered by live CBP/CBSA border intelligence, AI document processing, ECDSA cryptographic eBOL custody, and automated cross-border billing.
        </p>
      </div>

      <!-- Dual-Portal Action Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 max-w-xl">
        <a
          href="/quote"
          data-astro-prefetch
          class="flex items-center justify-between p-4 rounded-lg border border-bro-cyan/35 bg-bro-steel/60 hover:bg-bro-steel hover:border-bro-cyan transition-all group"
        >
          <div>
            <div class="font-mono text-xs font-bold text-white group-hover:text-bro-cyan uppercase">01 // Instant Rate Engine</div>
            <p class="text-[11px] text-slate-400 mt-0.5">Highway-routed CAD/USD + CO₂e</p>
          </div>
          <span class="font-mono text-bro-cyan font-bold group-hover:translate-x-1 transition-transform">→</span>
        </a>

        <a
          href="/portal/driver"
          data-astro-prefetch
          class="flex items-center justify-between p-4 rounded-lg border border-bro-gold/35 bg-bro-steel/60 hover:bg-bro-steel hover:border-bro-gold transition-all group"
        >
          <div>
            <div class="font-mono text-xs font-bold text-white group-hover:text-bro-gold uppercase">02 // Driver Offline PWA</div>
            <p class="text-[11px] text-slate-400 mt-0.5">Scan docs, DVIR, eBOL & settlements</p>
          </div>
          <span class="font-mono text-bro-gold font-bold group-hover:translate-x-1 transition-transform">→</span>
        </a>

        <a
          href="/portal/shipper"
          data-astro-prefetch
          class="flex items-center justify-between p-4 rounded-lg border border-white/10 bg-bro-steel/40 hover:bg-bro-steel hover:border-bro-cyan/60 transition-all group"
        >
          <div>
            <div class="font-mono text-xs font-bold text-slate-100 group-hover:text-bro-cyan uppercase">03 // Shipper Portal</div>
            <p class="text-[11px] text-slate-400 mt-0.5">Live tracking, FSMA temp & invoices</p>
          </div>
          <span class="font-mono text-slate-400 group-hover:text-bro-cyan group-hover:translate-x-1 transition-transform">→</span>
        </a>

        <a
          href="/ops"
          data-astro-prefetch
          class="flex items-center justify-between p-4 rounded-lg border border-white/10 bg-bro-steel/40 hover:bg-bro-steel hover:border-bro-gold/60 transition-all group"
        >
          <div>
            <div class="font-mono text-xs font-bold text-slate-100 group-hover:text-bro-gold uppercase">04 // Ops Command Tower</div>
            <p class="text-[11px] text-slate-400 mt-0.5">Dispatch, AI OCR, Customs & IFTA</p>
          </div>
          <span class="font-mono text-slate-400 group-hover:text-bro-gold group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>

    <!-- Right Column: Next-Gen Vector & Instanced 3D Command Globe -->
    <div class="lg:col-span-6 w-full">
      <div class="p-1 rounded-lg bg-gradient-to-br from-bro-cyan/40 via-white/10 to-bro-gold/40 shadow-2xl">
        <div class="rounded-[7px] bg-bro-obsidian overflow-hidden">
          <CommandGlobe client:load />
        </div>
      </div>
    </div>
  </div>
</section>
