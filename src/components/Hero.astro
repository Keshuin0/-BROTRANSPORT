---
import CommandGlobe from './globe/CommandGlobe';
---

<section class="relative overflow-hidden border-b border-white/[0.08] pt-24 pb-12 lg:pt-28 lg:pb-16 min-h-[760px] lg:min-h-[840px] flex flex-col justify-between">
  <!-- Right / Full-Bleed Atmospheric 3D Orbital Command Canvas -->
  <div class="lg:absolute lg:inset-y-12 lg:right-[-2%] lg:w-[64%] xl:w-[60%] z-10 order-2 lg:order-none px-3 sm:px-6 lg:px-0 mt-6 lg:mt-0">
    <CommandGlobe client:load variant="hero" />
  </div>

  <!-- Soft Editorial Readability Scrim (keeps left typography razor-sharp over WebGL limb) -->
  <div
    class="hidden lg:block absolute inset-y-0 left-0 w-[56%] bg-gradient-to-r from-[#020308] via-[#020308]/90 to-transparent pointer-events-none z-10"
    aria-hidden="true"
  ></div>

  <!-- Left Editorial Command Stage -->
  <div class="relative z-20 max-w-7xl mx-auto w-full px-4 sm:px-6 pt-6 lg:pt-14 order-1 lg:order-none pointer-events-none">
    <div class="max-w-xl space-y-7 pointer-events-auto">
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full liquid-glass-pill text-xs font-medium text-slate-200">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        <span>North America Transborder Operating System</span>
        <span class="text-slate-500">·</span>
        <span class="font-mono text-bro-cyan">SCAC BROP</span>
      </div>

      <div class="space-y-4">
        <h1 class="text-4xl sm:text-6xl xl:text-[4.25rem] font-display font-bold tracking-[-0.035em] leading-[1.02] text-white">
          Bold. Reliable. <br />
          <span class="bg-gradient-to-r from-white via-cyan-200 to-bro-cyan bg-clip-text text-transparent">
            Orchestrated.
          </span>
        </h1>
        <p class="text-base sm:text-lg text-slate-300/95 leading-relaxed max-w-lg">
          Commercial Dry Van, Cold-Chain Reefer, and Open-Deck Flatbed logistics connecting Atlantic Canada and continental North America—on live CBP/CBSA border intelligence and cryptographic chain-of-custody.
        </p>
      </div>

      <!-- Focused Primary Action Bar (2 Strong Choices — Apple HIG Clarity) -->
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href="/quote"
          data-astro-prefetch
          class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-full bg-white text-black hover:bg-bro-cyan font-semibold text-sm tracking-tight shadow-[0_10px_30px_-8px_rgba(255,255,255,0.35)] transition-all"
        >
          <span>Get Instant Lane Rate</span>
          <span aria-hidden="true">→</span>
        </a>

        <a
          href="/customs"
          data-astro-prefetch
          class="inline-flex items-center gap-2 px-5 py-3.5 rounded-full liquid-glass-pill text-white hover:border-white/30 text-sm font-medium transition-all"
        >
          <span>Border &amp; CARM Pre-Flight</span>
        </a>
      </div>

      <!-- Clean Split-Path Portal Access Bar -->
      <div class="pt-3 space-y-2.5">
        <div class="text-xs font-medium text-slate-400">Direct Portal Access</div>
        <div class="flex flex-wrap items-center gap-2">
          <a
            href="/portal/shipper"
            data-astro-prefetch
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl surface-ceramic text-xs font-medium text-slate-200 hover:text-white hover:border-bro-cyan/40 transition-colors"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-bro-cyan"></span>
            <span>Shipper Portal</span>
          </a>
          <a
            href="/portal/driver"
            data-astro-prefetch
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl surface-ceramic text-xs font-medium text-slate-200 hover:text-white hover:border-bro-gold/40 transition-colors"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-bro-gold"></span>
            <span>Driver Offline PWA</span>
          </a>
          <a
            href="/ops"
            data-astro-prefetch
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl surface-ceramic text-xs font-medium text-slate-200 hover:text-white hover:border-white/30 transition-colors"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            <span>Employee Ops Tower</span>
          </a>
          <a
            href="/verify"
            data-astro-prefetch
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl surface-ceramic text-xs font-medium text-slate-200 hover:text-white hover:border-emerald-400/40 transition-colors"
          >
            <span>Verify eBOL</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Quiet Bottom Capability Architecture Strip -->
  <div class="relative z-20 max-w-7xl mx-auto w-full px-4 sm:px-6 pt-10 lg:pt-16 order-3 lg:order-none pointer-events-none">
    <div class="max-w-3xl grid grid-cols-2 sm:grid-cols-4 gap-4 py-4 px-5 rounded-2xl liquid-glass pointer-events-auto">
      <div>
        <div class="text-[11px] text-slate-400">Crossings Synced</div>
        <div class="mt-0.5 font-mono text-sm font-semibold text-white tabular-nums">13 US / CA Ports</div>
      </div>
      <div>
        <div class="text-[11px] text-slate-400">Cold-Chain Control</div>
        <div class="mt-0.5 font-mono text-sm font-semibold text-bro-cyan tabular-nums">-28°C to +25°C</div>
      </div>
      <div>
        <div class="text-[11px] text-slate-400">Digital Custody</div>
        <div class="mt-0.5 font-mono text-sm font-semibold text-white">ECDSA P-256</div>
      </div>
      <div>
        <div class="text-[11px] text-slate-400">Customs Protocol</div>
        <div class="mt-0.5 font-mono text-sm font-semibold text-bro-gold">ACE · ACI CARM R2</div>
      </div>
    </div>
  </div>
</section>
