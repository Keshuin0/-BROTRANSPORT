---
import { getCollection } from 'astro:content';

const fleetEntries = await getCollection('fleet');
const order = { dry_van: 1, reefer: 2, flatbed: 3 };
const sorted = [...fleetEntries].sort(
  (a, b) => order[a.data.equipmentType] - order[b.data.equipmentType],
);

const HARDWARE_PHOTOS: Record<'dry_van' | 'reefer' | 'flatbed', { src: string; alt: string }> = {
  dry_van: {
    src: '/images/fleet/dry-van.webp',
    alt: 'Matte black Class 8 sleeper tractor pulling 53ft enclosed commercial dry van trailer along dark coastal highway',
  },
  reefer: {
    src: '/images/fleet/reefer.webp',
    alt: 'Class 8 semi-truck hauling illuminated 53ft FSMA cold-chain refrigerated reefer trailer at night loading dock',
  },
  flatbed: {
    src: '/images/fleet/flatbed.webp',
    alt: 'Heavy-duty stealth Class 8 tractor hauling secured structural steel on 53ft open-deck flatbed trailer at twilight',
  },
};
---

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  {sorted.map((entry) => {
    const d = entry.data;
    const photo = HARDWARE_PHOTOS[d.equipmentType];
    const isReefer = d.equipmentType === 'reefer';
    const isFlatbed = d.equipmentType === 'flatbed';
    const accentText = isFlatbed ? 'text-bro-gold' : isReefer ? 'text-bro-cyan' : 'text-sky-300';
    const accentBadge = isFlatbed
      ? 'border-bro-gold/35 bg-bro-gold/15 text-bro-gold'
      : isReefer
        ? 'border-bro-cyan/35 bg-bro-cyan/15 text-bro-cyan'
        : 'border-sky-400/35 bg-sky-400/15 text-sky-200';
    const hoverBorder = isFlatbed
      ? 'hover:border-bro-gold/50'
      : isReefer
        ? 'hover:border-bro-cyan/50'
        : 'hover:border-sky-400/50';

    return (
      <article class={`rounded-3xl surface-ceramic overflow-hidden flex flex-col justify-between transition-all group ${hoverBorder}`}>
        <div>
          <!-- Bespoke Photorealistic Commercial Equipment Header -->
          <div class="relative h-52 overflow-hidden bg-[#050811] border-b border-white/[0.07]">
            <img
              src={photo.src}
              alt={photo.alt}
              class="w-full h-full object-cover object-center group-hover:scale-[1.03] transition-transform duration-500"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-[#090d18] via-[#090d18]/25 to-transparent"
              aria-hidden="true"
            />
            <div class="absolute top-3.5 left-4 right-4 flex items-center justify-between gap-2">
              <span class={`inline-flex items-center px-3 py-1 rounded-full border text-[11px] font-medium uppercase tracking-wide backdrop-blur-md ${accentBadge}`}>
                {d.equipmentType.replace('_', ' ')} Division
              </span>
              <span class="px-2.5 py-1 rounded-full liquid-glass-pill font-mono text-[10px] text-white tabular-nums">
                53'0" Commercial
              </span>
            </div>
          </div>

          <div class="p-6 sm:p-7 space-y-5">
            <h3 class="text-xl font-display font-bold text-white tracking-tight leading-snug">{d.title}</h3>

            <div class="grid grid-cols-2 gap-3">
              <div class="p-3 rounded-2xl bg-[#060912] border border-white/[0.07]">
                <div class="text-[11px] text-slate-400">Max Payload</div>
                <div class="font-mono text-sm font-semibold text-white tabular-nums mt-0.5">
                  {d.capacityLbs.toLocaleString()} lbs
                </div>
              </div>
              <div class="p-3 rounded-2xl bg-[#060912] border border-white/[0.07]">
                <div class="text-[11px] text-slate-400">{d.tempRange ? 'Thermal Band' : 'Metric Capacity'}</div>
                <div class={`font-mono text-sm font-semibold mt-0.5 ${accentText}`}>
                  {d.tempRange ?? `${d.capacityTonnage} MT`}
                </div>
              </div>
            </div>

            <p class="text-sm text-slate-300/90 leading-relaxed">{entry.body}</p>

            <ul class="space-y-2 text-xs text-slate-300 border-t border-white/[0.08] pt-4">
              {d.equipmentSpecs.map((spec) => (
                <li class="flex items-start gap-2.5">
                  <span class={`mt-1.5 h-1.5 w-1.5 rounded-full shrink-0 ${isFlatbed ? 'bg-bro-gold' : 'bg-bro-cyan'}`}></span>
                  <span>{spec}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="px-6 sm:px-7 pb-6 sm:pb-7">
          <a
            href={`/quote?equipment=${d.equipmentType}`}
            data-astro-prefetch
            class={`block w-full text-center py-3 rounded-full font-semibold text-sm tracking-tight transition-all ${
              isFlatbed
                ? 'bg-bro-gold text-black hover:bg-amber-400'
                : 'bg-white text-black hover:bg-bro-cyan'
            }`}
          >
            Quote {d.equipmentType.replace('_', ' ')} Lane →
          </a>
        </div>
      </article>
    );
  })}
</div>
