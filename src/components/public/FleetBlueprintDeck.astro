---
import { getCollection } from 'astro:content';

const fleetEntries = await getCollection('fleet');
const order = { dry_van: 1, reefer: 2, flatbed: 3 };
const sorted = [...fleetEntries].sort(
  (a, b) => order[a.data.equipmentType] - order[b.data.equipmentType],
);
---

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  {sorted.map((entry) => {
    const d = entry.data;
    const isReefer = d.equipmentType === 'reefer';
    const isFlatbed = d.equipmentType === 'flatbed';
    const accentText = isFlatbed ? 'text-bro-gold' : isReefer ? 'text-bro-cyan' : 'text-sky-300';
    const accentBadge = isFlatbed
      ? 'border-bro-gold/30 bg-bro-gold/10 text-bro-gold'
      : isReefer
        ? 'border-bro-cyan/30 bg-bro-cyan/10 text-bro-cyan'
        : 'border-sky-400/30 bg-sky-400/10 text-sky-300';
    const hoverBorder = isFlatbed
      ? 'hover:border-bro-gold/45'
      : isReefer
        ? 'hover:border-bro-cyan/45'
        : 'hover:border-sky-400/45';

    return (
      <article class={`rounded-3xl surface-ceramic p-6 sm:p-7 flex flex-col justify-between space-y-6 transition-all ${hoverBorder}`}>
        <div class="space-y-5">
          <div class="flex items-center justify-between gap-2">
            <span class={`inline-flex items-center px-2.5 py-1 rounded-full border text-[11px] font-medium uppercase tracking-wide ${accentBadge}`}>
              {d.equipmentType.replace('_', ' ')} Division
            </span>
            <span class="font-mono text-[11px] text-slate-400">53ft North American</span>
          </div>

          <h3 class="text-xl font-display font-bold text-white tracking-tight leading-snug">{d.title}</h3>

          <!-- High-Precision Orthographic CAD Blueprint -->
          <div class="rounded-2xl bg-[#050811] border border-white/[0.07] p-4">
            <svg viewBox="0 0 320 104" class="w-full h-24" fill="none" aria-label={`${d.title} technical elevation diagram`}>
              <defs>
                <linearGradient id={`grad-${d.equipmentType}`} x1="0" y1="0" x2="320" y2="104" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color={isFlatbed ? '#FFAA00' : '#00F0FF'} stop-opacity="0.22" />
                  <stop offset="100%" stop-color={isFlatbed ? '#FFAA00' : '#00F0FF'} stop-opacity="0.02" />
                </linearGradient>
              </defs>
              {/* Dimension caliper line */}
              <line x1="74" y1="12" x2="298" y2="12" stroke="#475569" stroke-width="1" />
              <line x1="74" y1="8" x2="74" y2="16" stroke="#475569" stroke-width="1" />
              <line x1="298" y1="8" x2="298" y2="16" stroke="#475569" stroke-width="1" />
              <rect x="136" y="4" width="100" height="14" rx="4" fill="#050811" />
              <text x="186" y="13.5" fill="#94a3b8" font-size="8" font-family="monospace" text-anchor="middle">
                53'0" · MAX {(d.capacityLbs / 1000).toFixed(1)}K LBS
              </text>

              {/* Road baseline */}
              <line x1="8" y1="86" x2="312" y2="86" stroke="#334155" stroke-width="1" stroke-dasharray="4 4" />

              {/* Aerodynamic Sleeper Tractor */}
              <path d="M18 74V46L34 32H64V74H18Z" fill="#0e1528" stroke="#cbd5e1" stroke-width="1.4" />
              <path d="M36 37H58V49H30L36 37Z" fill={`url(#grad-${d.equipmentType})`} stroke={isFlatbed ? '#FFAA00' : '#00F0FF'} stroke-width="1" />
              <rect x="64" y="68" width="14" height="5" fill="#475569" />

              {/* Trailer Body */}
              {isFlatbed ? (
                <>
                  <rect x="74" y="64" width="224" height="8" rx="1.5" stroke="#FFAA00" stroke-width="1.6" fill={`url(#grad-${d.equipmentType})`} />
                  <rect x="108" y="38" width="142" height="24" rx="2" stroke="#FFAA00" stroke-width="1.2" stroke-dasharray="4 3" fill="#FFAA00" fill-opacity="0.06" />
                  <text x="179" y="53" fill="#FFAA00" font-size="8.5" font-family="monospace" text-anchor="middle">SECURED OPEN-DECK</text>
                </>
              ) : (
                <>
                  <rect x="74" y="23" width="224" height="49" rx="3" stroke={isReefer ? '#00F0FF' : '#94a3b8'} stroke-width="1.5" fill={`url(#grad-${d.equipmentType})`} />
                  {isReefer && (
                    <rect x="74" y="26" width="18" height="34" rx="1.5" stroke="#00F0FF" stroke-width="1.4" fill="#00F0FF" fill-opacity="0.22" />
                  )}
                  <text x="190" y="50" fill={isReefer ? '#00F0FF' : '#e2f1f8'} font-size="8.5" font-family="monospace" text-anchor="middle">
                    {isReefer ? 'THERMO KING · FSMA -28°C TO +25°C' : 'HIGH-CUBE COMPOSITE DRY VAN'}
                  </text>
                </>
              )}

              {/* Wheels */}
              {[32, 56, 68, 256, 274].map((cx) => (
                <g>
                  <circle cx={cx} cy="79" r="6.5" fill="#020308" stroke="#cbd5e1" stroke-width="1.4" />
                  <circle cx={cx} cy="79" r="2.2" fill={isFlatbed ? '#FFAA00' : '#00F0FF'} />
                </g>
              ))}
            </svg>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="p-3 rounded-2xl bg-[#070b15] border border-white/[0.07]">
              <div class="text-[11px] text-slate-400">Max Payload</div>
              <div class="font-mono text-sm font-semibold text-white tabular-nums mt-0.5">
                {d.capacityLbs.toLocaleString()} lbs
              </div>
            </div>
            <div class="p-3 rounded-2xl bg-[#070b15] border border-white/[0.07]">
              <div class="text-[11px] text-slate-400">{d.tempRange ? 'Thermal Band' : 'Metric Capacity'}</div>
              <div class={`font-mono text-sm font-semibold mt-0.5 ${accentText}`}>
                {d.tempRange ?? `${d.capacityTonnage} MT`}
              </div>
            </div>
          </div>

          <p class="text-sm text-slate-300/90 leading-relaxed">{entry.body}</p>

          <ul class="space-y-2 text-xs text-slate-300 border-t border-white/[0.08] pt-4">
            {d.equipmentSpecs.map((spec) => (
              <li class="flex items-start gap-2.5">
                <span class={`mt-1.5 h-1.5 w-1.5 rounded-full shrink-0 ${isFlatbed ? 'bg-bro-gold' : 'bg-bro-cyan'}`}></span>
                <span>{spec}</span>
              </li>
            ))}
          </ul>
        </div>

        <a
          href={`/quote?equipment=${d.equipmentType}`}
          data-astro-prefetch
          class={`block w-full text-center py-3 rounded-full font-semibold text-sm tracking-tight transition-all ${
            isFlatbed
              ? 'bg-bro-gold text-black hover:bg-amber-400'
              : 'bg-white text-black hover:bg-bro-cyan'
          }`}
        >
          Quote {d.equipmentType.replace('_', ' ')} Lane →
        </a>
      </article>
    );
  })}
</div>
