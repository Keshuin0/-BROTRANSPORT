---
import PublicLayout from '../layouts/PublicLayout.astro';
import Hero from '../components/Hero.astro';
import BorderWaitStrip from '../components/public/BorderWaitStrip';
import CorridorTwinShowcase from '../components/public/CorridorTwinShowcase';
import FastQuoteWidget from '../components/public/FastQuoteWidget';
import FleetBlueprintDeck from '../components/public/FleetBlueprintDeck.astro';
---

<PublicLayout>
  <Hero />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-14 sm:py-20 space-y-16">
    <!-- Live CBP/CBSA Border Crossing Intelligence Ribbon -->
    <div data-reveal="fade-up">
      <BorderWaitStrip client:load />
    </div>

    <!-- Interactive Cross-Border Corridor Digital Twin & 5-Stage Pipeline -->
    <div data-reveal="fade-up">
      <CorridorTwinShowcase client:load />
    </div>

    <!-- Spatial Bento Command Grid (Clear h1 -> h2 -> h3 Document Outline) -->
    <div class="space-y-8">
      <div
        data-reveal="fade-up"
        class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-white/[0.08] pb-5"
      >
        <div class="space-y-1.5">
          <div class="text-xs font-medium text-bro-cyan">Unified Cross-Border Architecture</div>
          <h2 class="text-title-fluid font-display font-bold text-white">
            Built for Cross-Border Execution
          </h2>
        </div>
        <p class="text-sm text-slate-300 max-w-md">
          Deterministic tariffs, dual-portal RBAC dispatch, and cryptographic custody engineered in one operational stack.
        </p>
      </div>

      <div data-reveal-group class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        <div class="lg:col-span-5">
          <FastQuoteWidget client:load />
        </div>

        <!-- Dual-Portal Operating System Card -->
        <div class="lg:col-span-4 rounded-3xl surface-ceramic p-6 sm:p-7 flex flex-col justify-between space-y-6 hover:border-bro-cyan/40 transition-colors">
          <div class="space-y-4">
            <div class="flex items-center justify-between gap-2">
              <span class="px-2.5 py-1 rounded-full border border-bro-cyan/30 bg-bro-cyan/10 text-xs font-medium text-bro-cyan">
                Dual-Portal OS
              </span>
              <span class="font-mono text-[11px] text-slate-300">Zero-Trust RBAC</span>
            </div>

            <h3 class="text-xl font-display font-bold text-white tracking-tight">
              One Platform. Every Role.
            </h3>

            <p class="text-sm text-slate-300 leading-relaxed">
              Built cleanly on Cloudflare Workers with real-time Durable Object WebSockets, D1 relational ledger, R2 vault storage, and Human-in-the-Loop Workflows.
            </p>

            <div class="space-y-2.5 pt-1">
              <div class="p-3.5 rounded-2xl bg-[#070b15] border border-white/[0.07] space-y-1">
                <div class="flex items-center justify-between text-xs font-semibold text-white">
                  <span>External Portal · Shipper &amp; Driver</span>
                  <span class="h-2 w-2 rounded-full bg-bro-cyan" aria-hidden="true"></span>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed">
                  Live FSMA temp logs, 1-click booking, offline camera doc scan, 12-point DVIR OOS lock &amp; eBOL signing.
                </p>
              </div>

              <div class="p-3.5 rounded-2xl bg-[#070b15] border border-white/[0.07] space-y-1">
                <div class="flex items-center justify-between text-xs font-semibold text-white">
                  <span>Internal Tower · Employee &amp; Admin</span>
                  <span class="h-2 w-2 rounded-full bg-bro-gold" aria-hidden="true"></span>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed">
                  Dispatch &amp; EDI X12, AI OCR HITL queue, ACE/ACI CARM R2 desk, factoring packets &amp; IFTA tax.
                </p>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-2.5">
            <a
              href="/portal/shipper"
              class="min-h-[44px] flex items-center justify-center text-center py-2.5 px-3 rounded-full border border-white/15 bg-white/[0.05] hover:bg-white/[0.12] text-white text-xs font-semibold transition-colors"
            >
              Shipper Portal →
            </a>
            <a
              href="/ops"
              class="min-h-[44px] flex items-center justify-center text-center py-2.5 px-3 rounded-full border border-bro-gold/40 bg-bro-gold/10 hover:bg-bro-gold/20 text-bro-gold text-xs font-semibold transition-colors"
            >
              Ops Tower →
            </a>
          </div>
        </div>

        <!-- Cryptographic eBOL & Compliance Assurance Card -->
        <div class="lg:col-span-3 rounded-3xl surface-ceramic p-6 sm:p-7 flex flex-col justify-between space-y-6 hover:border-bro-cyan/40 transition-colors">
          <div class="space-y-4">
            <div class="flex items-center justify-between gap-2">
              <span class="px-2.5 py-1 rounded-full border border-emerald-400/35 bg-emerald-500/10 text-xs font-medium text-emerald-300">
                ECDSA P-256
              </span>
              <span class="font-mono text-[11px] text-slate-300">SHA-256 Chain</span>
            </div>

            <h3 class="text-xl font-display font-bold text-white tracking-tight">
              Tamper-Proof eBOL Custody
            </h3>

            <p class="text-sm text-slate-300 leading-relaxed">
              Every shipper release, pickup scan, and consignee POD is cryptographically signed in-browser via Web Crypto APIs—independently auditable by brokers and insurers.
            </p>

            <div class="p-3.5 rounded-2xl bg-[#070b15] border border-white/[0.07] font-mono text-xs text-slate-300 space-y-2">
              <div class="flex justify-between items-center">
                <span class="text-slate-300">CBP ACE</span>
                <span class="text-bro-cyan font-semibold">SCAC BROP</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-300">CBSA CARM R2</span>
                <span class="text-emerald-300 font-semibold">IOR Verified</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-300">FMCSA Audit</span>
                <span class="text-bro-gold font-semibold">Live USDOT</span>
              </div>
            </div>
          </div>

          <a
            href="/verify"
            data-astro-prefetch
            class="min-h-[44px] flex items-center justify-center w-full text-center py-2.5 px-4 rounded-full bg-white hover:bg-bro-cyan text-black text-xs font-semibold tracking-tight transition-colors"
          >
            Open eBOL Tamper Lab →
          </a>
        </div>
      </div>
    </div>

    <!-- Commercial 53ft Fleet Specifications -->
    <div class="space-y-8 pt-2">
      <div
        data-reveal="fade-up"
        class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-white/[0.08] pb-5"
      >
        <div class="space-y-1.5">
          <div class="text-xs font-medium text-bro-cyan">North American Fleet Hardware</div>
          <h2 class="text-title-fluid font-display font-bold text-white">
            53ft Commercial Divisions
          </h2>
        </div>
        <a
          href="/apply"
          class="min-h-[44px] inline-flex items-center gap-2 px-4 py-2 rounded-full liquid-glass-pill text-xs font-semibold text-bro-gold hover:border-bro-gold/50 transition-colors shrink-0"
        >
          <span>Drive With #BRO · FMCSA Onboarding</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <FleetBlueprintDeck />
    </div>
  </section>
</PublicLayout>
