---
import PublicLayout from '../layouts/PublicLayout.astro';
import Hero from '../components/Hero.astro';
import BorderWaitStrip from '../components/public/BorderWaitStrip';
import FastQuoteWidget from '../components/public/FastQuoteWidget';
import FleetBlueprintDeck from '../components/public/FleetBlueprintDeck.astro';
---

<PublicLayout>
  <Hero />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-14 space-y-10">
    <!-- 01: Live Government Border Intelligence -->
    <BorderWaitStrip client:load />

    <!-- Balanced 12-Col Bento Command Row (No Orphan Columns!) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      <div class="lg:col-span-4 flex flex-col">
        <FastQuoteWidget client:load />
      </div>

      <!-- 03: Dual-Portal Architecture Card -->
      <div class="lg:col-span-4 rounded-lg border border-white/10 bg-bro-steel/40 p-6 flex flex-col justify-between space-y-5 hover:border-bro-cyan/50 transition-colors">
        <div class="space-y-3">
          <div class="flex items-center justify-between font-mono text-[10px] uppercase">
            <span class="text-slate-400">03 // DUAL-PORTAL OS</span>
            <span class="text-bro-cyan font-bold">ZERO-TRUST RBAC</span>
          </div>
          <h2 class="text-lg font-display font-bold text-white">One Platform. Every Stakeholder.</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            Built on single-origin Cloudflare Workers with real-time Durable Object WebSockets, D1 relational persistence, R2 immutable document storage, and Cloudflare Workflows with Human-in-the-Loop governance.
          </p>
          <ul class="space-y-1.5 font-mono text-[11px] text-slate-300 pt-1">
            <li>• <strong class="text-bro-cyan">Portal 1 (External):</strong> Shippers track FSMA temp logs & pay invoices; Drivers scan BOL/POD/lumpers offline in border dead zones.</li>
            <li>• <strong class="text-bro-gold">Portal 2 (Internal Ops):</strong> Dispatch, AI OCR Review Queue, ACE/ACI CARM Customs, Factoring Packets, Driver Settlements & IFTA.</li>
          </ul>
        </div>
        <div class="grid grid-cols-2 gap-2.5 pt-2">
          <a href="/portal/shipper" class="text-center py-2 rounded border border-bro-cyan/40 text-bro-cyan hover:bg-bro-cyan/10 font-mono text-[11px] font-bold uppercase">
            Portal 1 →
          </a>
          <a href="/ops" class="text-center py-2 rounded border border-bro-gold/40 text-bro-gold hover:bg-bro-gold/10 font-mono text-[11px] font-bold uppercase">
            Portal 2 →
          </a>
        </div>
      </div>

      <!-- 04: Cryptographic eBOL & Compliance Assurance -->
      <div class="lg:col-span-4 rounded-lg border border-white/10 bg-bro-steel/40 p-6 flex flex-col justify-between space-y-5 hover:border-emerald-400/50 transition-colors">
        <div class="space-y-3">
          <div class="flex items-center justify-between font-mono text-[10px] uppercase">
            <span class="text-slate-400">04 // CRYPTOGRAPHIC eBOL</span>
            <span class="text-emerald-400 font-bold">ECDSA P-256</span>
          </div>
          <h2 class="text-lg font-display font-bold text-white">Tamper-Proof Chain of Custody</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            Every shipper release, driver pickup scan, and consignee POD is cryptographically signed via Web Crypto ECDSA P-256 and chained by SHA-256 digests—independently verifiable by brokers, insurers, and factoring partners.
          </p>
          <div class="p-3 rounded bg-bro-obsidian/80 border border-white/10 font-mono text-[10px] text-slate-300 space-y-1">
            <div class="flex justify-between"><span>CBP ACE / PAPS:</span><span class="text-bro-cyan font-bold">SCAC BROP</span></div>
            <div class="flex justify-between"><span>CBSA ACI / CARM R2:</span><span class="text-emerald-400 font-bold">IOR BOND GATED</span></div>
            <div class="flex justify-between"><span>FMCSA Vetting:</span><span class="text-bro-gold font-bold">LIVE USDOT API</span></div>
          </div>
        </div>
        <a
          href="/verify"
          data-astro-prefetch
          class="block w-full text-center py-2.5 rounded border border-emerald-400/40 bg-emerald-950/30 hover:bg-emerald-950/60 text-emerald-300 font-mono text-xs font-bold uppercase tracking-wider transition-colors"
        >
          Open Cryptographic eBOL Lab →
        </a>
      </div>
    </div>

    <!-- 05: Active Commercial Fleet Blueprint Deck (Powered by Astro Content Collection MDX) -->
    <div class="space-y-6 pt-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-white/10 pb-4">
        <div>
          <span class="font-mono text-[10px] uppercase tracking-widest text-bro-cyan font-bold">
            05 // COMMERCIAL FLEET SPECIFICATIONS
          </span>
          <h2 class="text-2xl sm:text-3xl font-display font-black uppercase tracking-tight text-white mt-1">
            53ft North American Divisions
          </h2>
        </div>
        <a href="/apply" class="font-mono text-xs uppercase text-bro-gold hover:underline">
          Drive With #BRO (FMCSA Vetted Onboarding) →
        </a>
      </div>

      <FleetBlueprintDeck />
    </div>
  </section>
</PublicLayout>
