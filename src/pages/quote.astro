---
import PublicLayout from '../layouts/PublicLayout.astro';
import LiveQuoteEngine from '../components/public/LiveQuoteEngine';
---

<PublicLayout
  title="Instant Rate Calculator | #BRO Transport Corp."
  description="Geography-aware commercial Dry Van, Cold-Chain Reefer, and Open-Deck Flatbed shipping rate engine with live border crossings and SmartWay CO2e estimates."
>
  <section class="pt-6 sm:pt-10 pb-10 px-4 sm:px-6 border-b border-white/[0.08]">
    <div class="max-w-6xl mx-auto space-y-2.5">
      <div class="text-xs font-medium text-bro-cyan">Live Lane Tariff Engine</div>
      <h1 class="text-title-fluid font-display font-bold text-white">
        Operational Freight Rate Calculator
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl leading-relaxed">
        Real highway mileage routing, live CBP/CBSA border port assignment, integer-cent linehaul &amp; fuel surcharge math, and EPA SmartWay carbon estimates.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
    <LiveQuoteEngine client:load />
  </section>
</PublicLayout>
