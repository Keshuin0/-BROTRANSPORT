---
import PublicLayout from '../layouts/PublicLayout.astro';
import LiveQuoteEngine from '../components/public/LiveQuoteEngine';
---

<PublicLayout
  title="Instant Rate Calculator | #BRO Transport Corp."
  description="Geography-aware commercial Dry Van, Cold-Chain Reefer, and Open-Deck Flatbed shipping rate engine with live border crossings and SmartWay CO2e estimates."
>
  <section class="py-12 px-4 sm:px-6 border-b border-white/10 bg-bro-steel/20">
    <div class="max-w-5xl mx-auto space-y-2">
      <span class="font-mono text-[10px] uppercase tracking-widest text-bro-cyan font-bold">
        // PROCUREMENT_RATE_ENGINE
      </span>
      <h1 class="text-3xl sm:text-4xl font-display font-black uppercase tracking-tight text-white">
        Operational Freight Rate Calculator
      </h1>
      <p class="text-sm text-slate-300 max-w-2xl">
        Real highway mileage routing, live CBP/CBSA border port assignment, integer-cent linehaul & fuel surcharge math, and EPA SmartWay carbon estimates.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <LiveQuoteEngine client:load />
  </section>
</PublicLayout>
