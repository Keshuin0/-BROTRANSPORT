---
import PublicLayout from '../layouts/PublicLayout.astro';
import ActivateAccountForm from '../components/auth/ActivateAccountForm';

const token = Astro.url.searchParams.get('token') ?? '';
const mode = Astro.url.searchParams.get('mode') ?? '';
const nextPath = Astro.url.searchParams.get('next') ?? '';
const currentUser = Astro.locals.user;
---

<PublicLayout title="Account Activation & Credential Setup | #BRO Transport Corp.">
  <section class="pt-6 sm:pt-10 pb-16 px-4 sm:px-6">
    <ActivateAccountForm
      client:load
      token={token}
      mode={mode}
      nextPath={nextPath}
      currentUser={currentUser}
    />
  </section>
</PublicLayout>
