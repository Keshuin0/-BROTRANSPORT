---
import PublicLayout from '../../layouts/PublicLayout.astro';
import EbolCryptoLab from '../../components/public/EbolCryptoLab';

const ebolId = Astro.params.ebolId ?? 'BROP-2026-9948';
---

<PublicLayout
  title={`Verify eBOL ${ebolId} | #BRO Transport Corp.`}
  description={`Independent ECDSA P-256 cryptographic verification of shipment custody chain ${ebolId}.`}
>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <EbolCryptoLab client:load initialLoadId={ebolId} />
  </section>
</PublicLayout>
