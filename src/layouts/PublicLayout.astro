---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import BroLogo from '../components/brand/BroLogo.astro';
import CommandPalette from '../components/nav/CommandPalette';
import AllyEscalationDrawer from '../components/nav/AllyEscalationDrawer';
import MobileNavDrawer from '../components/nav/MobileNavDrawer';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '#BRO Transport Corp. | North American Transborder Logistics OS',
  description = 'Bold. Reliable. Orchestrated. Commercial Dry Van, Cold-Chain Reefer, and Open-Deck Flatbed cross-border logistics with live CBP/CBSA border intelligence, cryptographic eBOL, and AI document automation.',
} = Astro.props;

const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, Astro.site ?? 'https://brotransport.com').toString();
const user = Astro.locals.user;

const navLinks = [
  { href: '/', label: 'Overview' },
  { href: '/quote', label: 'Rates' },
  { href: '/customs', label: 'Customs' },
  { href: '/verify', label: 'Verify eBOL' },
  { href: '/apply', label: 'Carriers' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '#BRO Transport Corp.',
  url: 'https://brotransport.com',
  slogan: 'A Bro in Need Is a Bro Indeed',
  description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Charlottetown',
    addressRegion: 'PE',
    addressCountry: 'CA',
  },
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#020308" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <ClientRouter />
  </head>
  <body class="bg-spatial-cosmos text-bro-ice min-h-screen flex flex-col justify-between selection:bg-bro-cyan/30 selection:text-white pb-24 md:pb-0">
    <div>
      <!-- Floating Apple Liquid Glass Capsule Navigation -->
      <header class="sticky top-3 z-40 px-3 sm:px-6 pointer-events-none">
        <div class="max-w-7xl mx-auto rounded-full liquid-glass px-3 sm:px-5 h-14 sm:h-16 flex items-center justify-between gap-3 pointer-events-auto">
          <a href="/" class="shrink-0 pl-1 rounded-full focus-visible:outline-2 focus-visible:outline-bro-cyan">
            <BroLogo compact />
          </a>

          <nav aria-label="Primary Navigation" class="hidden md:flex items-center gap-1 rounded-full bg-white/[0.04] p-1 border border-white/[0.06]">
            {navLinks.map((link) => {
              const active = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
              return (
                <a
                  href={link.href}
                  data-astro-prefetch
                  aria-current={active ? 'page' : undefined}
                  class={`px-3.5 py-1.5 rounded-full text-xs font-medium transition-all ${
                    active
                      ? 'bg-white text-black font-semibold shadow-sm'
                      : 'text-slate-300 hover:text-white hover:bg-white/[0.07]'
                  }`}
                >
                  {link.label}
                </a>
              );
            })}
          </nav>

          <div class="flex items-center gap-2">
            <CommandPalette client:load />
            <a
              href={user ? (user.role === 'carrier_driver' ? '/portal/driver' : user.role.startsWith('shipper') ? '/portal/shipper' : '/ops') : '/login'}
              class="hidden lg:inline-flex items-center px-3.5 py-1.5 rounded-full border border-white/15 bg-white/[0.05] hover:bg-white/[0.12] hover:border-white/30 text-white text-xs font-medium transition-all"
            >
              {user ? `Portal (${user.name.split(' ')[0]})` : 'Sign In'}
            </a>
            <AllyEscalationDrawer client:load />
            <MobileNavDrawer client:load currentPath={pathname} userRole={user?.role ?? null} />
          </div>
        </div>
      </header>

      <main class="w-full -mt-16 sm:-mt-[4.5rem]">
        <slot />
      </main>
    </div>

    <!-- iOS-Inspired Floating Liquid Glass Mobile Dock (<768px) -->
    <nav
      aria-label="Mobile Quick Dock"
      class="md:hidden fixed bottom-3 inset-x-3 z-40 rounded-2xl liquid-glass grid grid-cols-4 p-1.5"
    >
      <a
        href="/"
        aria-current={pathname === '/' ? 'page' : undefined}
        class={`min-h-[46px] rounded-xl flex flex-col items-center justify-center gap-0.5 text-[10px] font-medium transition-colors ${
          pathname === '/' ? 'bg-white text-black font-semibold' : 'text-slate-300'
        }`}
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
        </svg>
        <span>Command</span>
      </a>
      <a
        href="/quote"
        aria-current={pathname.startsWith('/quote') ? 'page' : undefined}
        class={`min-h-[46px] rounded-xl flex flex-col items-center justify-center gap-0.5 text-[10px] font-medium transition-colors ${
          pathname.startsWith('/quote') ? 'bg-white text-black font-semibold' : 'text-slate-300'
        }`}
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="4" y="2" width="16" height="20" rx="2" /><line x1="8" y1="6" x2="16" y2="6" /><line x1="8" y1="14" x2="16" y2="14" />
        </svg>
        <span>Rates</span>
      </a>
      <a
        href="/portal/driver"
        aria-current={pathname.startsWith('/portal/driver') ? 'page' : undefined}
        class={`min-h-[46px] rounded-xl flex flex-col items-center justify-center gap-0.5 text-[10px] font-medium transition-colors ${
          pathname.startsWith('/portal/driver') ? 'bg-white text-black font-semibold' : 'text-slate-300'
        }`}
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" /><path d="M15 18H9" /><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14" /><circle cx="17" cy="18" r="2" /><circle cx="7" cy="18" r="2" />
        </svg>
        <span>Driver</span>
      </a>
      <a
        href="/ops"
        aria-current={pathname.startsWith('/ops') ? 'page' : undefined}
        class={`min-h-[46px] rounded-xl flex flex-col items-center justify-center gap-0.5 text-[10px] font-medium transition-colors ${
          pathname.startsWith('/ops') ? 'bg-white text-black font-semibold' : 'text-slate-300'
        }`}
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
        <span>Ops</span>
      </a>
    </nav>

    <footer class="w-full border-t border-white/[0.08] bg-[#04060c]/90 py-14 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 md:grid-cols-12 gap-10 text-xs">
        <div class="space-y-3 md:col-span-6">
          <BroLogo compact showSlogan />
          <p class="text-slate-400 max-w-md pt-2 text-sm leading-relaxed">
            Atlantic Canada &amp; North America commercial cross-border freight carrier &amp; digital operating system.
            Engineered on Cloudflare edge with deterministic customs pre-flight, offline driver tooling, and ECDSA P-256 custody.
          </p>
          <div class="pt-1 flex flex-wrap items-center gap-2 font-mono text-[11px] text-slate-400">
            <span class="px-2.5 py-1 rounded-full border border-white/10 bg-white/[0.03] text-bro-cyan">SCAC BROP</span>
            <span class="px-2.5 py-1 rounded-full border border-white/10 bg-white/[0.03]">Charlottetown, PEI Headquarters</span>
          </div>
        </div>

        <div class="space-y-3 md:col-span-3">
          <div class="text-white font-semibold tracking-tight text-sm">External Portal</div>
          <ul class="space-y-2 text-slate-400 text-xs">
            <li><a href="/quote" class="hover:text-white transition-colors">Instant Rate Calculator</a></li>
            <li><a href="/portal/shipper" class="hover:text-white transition-colors">Customer &amp; Shipper Portal</a></li>
            <li><a href="/portal/driver" class="hover:text-white transition-colors">Driver Offline PWA</a></li>
            <li><a href="/verify" class="hover:text-white transition-colors">Cryptographic eBOL Verifier</a></li>
            <li><a href="/apply" class="hover:text-white transition-colors">Carrier &amp; Driver Onboarding</a></li>
          </ul>
        </div>

        <div class="space-y-3 md:col-span-3">
          <div class="text-white font-semibold tracking-tight text-sm">Operations Command</div>
          <ul class="space-y-2 text-slate-400 text-xs">
            <li><a href="/ops" class="hover:text-bro-gold transition-colors">Control Tower Overview</a></li>
            <li><a href="/ops/dispatch" class="hover:text-bro-gold transition-colors">Dispatch Board &amp; EDI X12</a></li>
            <li><a href="/ops/documents" class="hover:text-bro-gold transition-colors">AI Document OCR Queue</a></li>
            <li><a href="/ops/customs" class="hover:text-bro-gold transition-colors">ACE / ACI CARM Desk</a></li>
            <li><a href="/ops/billing" class="hover:text-bro-gold transition-colors">Billing, Factoring &amp; IFTA</a></li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 mt-10 pt-6 border-t border-white/[0.06] flex flex-col sm:flex-row justify-between items-center gap-3 text-[11px] text-slate-500">
        <span>© 2026 #BRO Transport Corp. All rights reserved.</span>
        <span class="font-mono">CBP ACE PAPS · CBSA ACI PARS · CARM Release 2 · ECDSA P-256</span>
      </div>
    </footer>
  </body>
</html>
