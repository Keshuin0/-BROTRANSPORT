---
import { ClientRouter } from 'astro:transitions';
import { canAccessRoute, isOpsRole } from '@bro/contracts';
import '../styles/global.css';
import BroLogo from '../components/brand/BroLogo.astro';
import CommandPalette from '../components/nav/CommandPalette';
import AllyEscalationDrawer from '../components/nav/AllyEscalationDrawer';
import MobileNavDrawer from '../components/nav/MobileNavDrawer';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '#BRO Transport Corp. | North American Transborder Logistics OS',
  description = 'Bold. Reliable. Orchestrated. Commercial Dry Van, Cold-Chain Reefer, and Open-Deck Flatbed cross-border logistics with live CBP/CBSA border intelligence, cryptographic eBOL, and AI document automation.',
} = Astro.props;

const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, Astro.site ?? 'https://brotransport.com').toString();
const user = Astro.locals.user;
const role = user?.role ?? 'visitor';
const isAuthenticated = Boolean(user && user.role !== 'visitor');

const portalHref = !isAuthenticated
  ? '/login'
  : user!.role === 'carrier_driver'
    ? '/portal/driver'
    : user!.role.startsWith('shipper')
      ? '/portal/shipper'
      : '/ops';

const portalLabel = !isAuthenticated
  ? 'Sign In'
  : user!.role === 'carrier_driver'
    ? 'Driver'
    : user!.role.startsWith('shipper')
      ? 'Shipper'
      : 'Ops';

const isStaffOps = Boolean(user && isOpsRole(user.role));

const navLinks = [
  { href: '/', label: 'Overview' },
  { href: '/quote', label: 'Rates' },
  { href: '/customs', label: 'Customs' },
  { href: '/verify', label: 'Verify eBOL' },
  { href: '/apply', label: 'Carriers' },
];

const opsFooterLinks = [
  { href: '/ops', label: 'Control Tower Overview' },
  { href: '/ops/dispatch', label: 'Dispatch Board & EDI X12' },
  { href: '/ops/documents', label: 'AI Document OCR Queue' },
  { href: '/ops/customs', label: 'ACE / ACI CARM Desk' },
  { href: '/ops/billing', label: 'Billing, Factoring & IFTA' },
].filter((item) => !isStaffOps || canAccessRoute(role, item.href));

const shipperPortalHref =
  isAuthenticated && canAccessRoute(role, '/portal/shipper')
    ? '/portal/shipper'
    : '/login?next=%2Fportal%2Fshipper';

const driverPortalHref =
  isAuthenticated && canAccessRoute(role, '/portal/driver')
    ? '/portal/driver'
    : '/login?next=%2Fportal%2Fdriver';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '#BRO Transport Corp.',
  url: 'https://brotransport.com',
  slogan: 'A Bro in Need Is a Bro Indeed',
  description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Charlottetown',
    addressRegion: 'PE',
    addressCountry: 'CA',
  },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#020308" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preload" href="/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <ClientRouter />
    <script>
      import '../lib/motionRuntime';
    </script>
  </head>
  <body class="bg-spatial-cosmos text-bro-ice min-h-screen flex flex-col justify-between selection:bg-bro-cyan/30 selection:text-white pb-28 md:pb-0">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[130] focus:px-4 focus:py-2.5 focus:rounded-full focus:bg-bro-cyan focus:text-black focus:text-xs focus:font-bold"
    >
      Skip to main content
    </a>

    <div class="pt-3">
      <!-- Floating Apple Liquid Glass Capsule Navigation -->
      <header class="sticky top-3 z-40 px-2 sm:px-6 pointer-events-none">
        <div class="max-w-7xl mx-auto rounded-full liquid-glass px-2.5 sm:px-5 h-14 sm:h-16 flex items-center justify-between gap-1.5 sm:gap-3 pointer-events-auto">
          <a href="/" class="shrink-0 pl-1 rounded-full focus-visible:outline-2 focus-visible:outline-bro-cyan">
            <BroLogo compact uid="hdr" />
          </a>

          <nav
            aria-label="Primary Navigation"
            class="hidden lg:flex items-center gap-1 rounded-full bg-white/[0.04] p-1 border border-white/[0.06] shrink-0"
          >
            {navLinks.map((link) => {
              const active = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
              return (
                <a
                  href={link.href}
                  data-astro-prefetch
                  aria-current={active ? 'page' : undefined}
                  class={`px-2.5 xl:px-3.5 py-1.5 rounded-full text-xs font-medium whitespace-nowrap shrink-0 transition-colors ${
                    active
                      ? 'bg-white text-black font-semibold shadow-sm'
                      : 'text-slate-300 hover:text-white hover:bg-white/[0.07]'
                  }`}
                >
                  {link.label}
                </a>
              );
            })}
          </nav>

          <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
            <CommandPalette client:load userRole={user?.role ?? null} />
            <a
              href={portalHref}
              class="hidden lg:inline-flex items-center px-3 xl:px-3.5 min-h-[44px] rounded-full border border-white/15 bg-white/[0.05] hover:bg-white/[0.12] hover:border-white/30 text-white text-xs font-medium whitespace-nowrap shrink-0 transition-colors max-w-[148px] truncate"
            >
              {isAuthenticated ? `Portal (${user!.name.split(' ')[0]})` : 'Sign In'}
            </a>
            <AllyEscalationDrawer client:load />
            <MobileNavDrawer
              client:load
              currentPath={pathname}
              userRole={user?.role ?? null}
              userName={user?.name ?? null}
            />
          </div>
        </div>
      </header>

      <main id="main-content" class="w-full">
        <slot />
      </main>
    </div>

    <!-- iOS-Inspired Floating Liquid Glass Mobile Dock (<768px) with Edge Fade Skirt -->
    <div class="md:hidden fixed bottom-0 inset-x-0 z-40 px-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] pt-6 dock-edge-fade pointer-events-none">
      <nav
        aria-label="Mobile Quick Dock"
        class="pointer-events-auto mx-auto max-w-md rounded-2xl liquid-glass grid grid-cols-4 gap-1 p-1.5"
      >
        <a
          href="/"
          aria-current={pathname === '/' ? 'page' : undefined}
          class={`min-h-[46px] rounded-xl flex flex-col items-center justify-center gap-0.5 text-[11px] font-medium whitespace-nowrap transition-colors ${
            pathname === '/' ? 'bg-white text-black font-semibold' : 'text-slate-200 hover:text-white'
          }`}
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          <span>Command</span>
        </a>

        <a
          href="/quote"
          aria-current={pathname.startsWith('/quote') ? 'page' : undefined}
          class={`min-h-[46px] rounded-xl flex flex-col items-center justify-center gap-0.5 text-[11px] font-medium whitespace-nowrap transition-colors ${
            pathname.startsWith('/quote') ? 'bg-white text-black font-semibold' : 'text-slate-200 hover:text-white'
          }`}
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="4" y="2" width="16" height="20" rx="2" /><line x1="8" y1="6" x2="16" y2="6" /><line x1="8" y1="14" x2="16" y2="14" />
          </svg>
          <span>Rates</span>
        </a>

        <a
          href={portalHref}
          aria-current={!isAuthenticated ? (pathname.startsWith('/login') ? 'page' : undefined) : (pathname.startsWith(portalHref) ? 'page' : undefined)}
          class={`min-h-[46px] rounded-xl flex flex-col items-center justify-center gap-0.5 text-[11px] font-medium whitespace-nowrap transition-colors ${
            (!isAuthenticated ? pathname.startsWith('/login') : pathname.startsWith(portalHref))
              ? 'bg-white text-black font-semibold'
              : 'text-slate-200 hover:text-white'
          }`}
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" /><path d="M15 18H9" /><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14" /><circle cx="17" cy="18" r="2" /><circle cx="7" cy="18" r="2" />
          </svg>
          <span>{portalLabel}</span>
        </a>

        <a
          href="/customs"
          aria-current={pathname.startsWith('/customs') ? 'page' : undefined}
          class={`min-h-[46px] rounded-xl flex flex-col items-center justify-center gap-0.5 text-[11px] font-medium whitespace-nowrap transition-colors ${
            pathname.startsWith('/customs') ? 'bg-white text-black font-semibold' : 'text-slate-200 hover:text-white'
          }`}
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" />
          </svg>
          <span>Customs</span>
        </a>
      </nav>
    </div>

    <footer class="w-full border-t border-white/[0.08] bg-[#04060c]/90 py-14 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 md:grid-cols-12 gap-10 text-xs">
        <div class="space-y-3 md:col-span-6">
          <BroLogo compact showSlogan uid="ftr" />
          <p class="text-slate-300 max-w-md pt-2 text-sm leading-relaxed">
            Atlantic Canada &amp; North America commercial cross-border freight carrier &amp; digital operating system.
            Engineered on Cloudflare edge with deterministic customs pre-flight, offline driver tooling, and ECDSA P-256 custody.
          </p>
          <div class="pt-1 flex flex-wrap items-center gap-2 font-mono text-[11px] text-slate-300">
            <span class="px-2.5 py-1 rounded-full border border-white/10 bg-white/[0.03] text-bro-cyan">SCAC BROP</span>
            <span class="px-2.5 py-1 rounded-full border border-white/10 bg-white/[0.03]">Charlottetown, PEI Headquarters</span>
          </div>
        </div>

        <div class="space-y-3 md:col-span-3">
          <div class="text-white font-semibold tracking-tight text-sm">External Portal</div>
          <ul class="space-y-2.5 text-slate-300 text-xs">
            <li><a href="/quote" class="hover:text-white transition-colors">Instant Rate Calculator</a></li>
            <li>
              <a href={shipperPortalHref} class="hover:text-white transition-colors">
                Customer &amp; Shipper Portal
              </a>
            </li>
            <li>
              <a href={driverPortalHref} class="hover:text-white transition-colors">
                Driver Offline PWA
              </a>
            </li>
            <li><a href="/verify" class="hover:text-white transition-colors">Cryptographic eBOL Verifier</a></li>
            <li><a href="/apply" class="hover:text-white transition-colors">Carrier &amp; Driver Onboarding</a></li>
          </ul>
        </div>

        <div class="space-y-3 md:col-span-3">
          <div class="text-white font-semibold tracking-tight text-sm">
            {isStaffOps ? 'Operations Command' : 'Operations Command (Staff)'}
          </div>
          {isStaffOps ? (
            <ul class="space-y-2.5 text-slate-300 text-xs">
              {opsFooterLinks.map((item) => (
                <li>
                  <a href={item.href} class="hover:text-bro-gold transition-colors">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="space-y-2.5 text-xs">
              <p class="text-slate-400 leading-relaxed">
                Internal dispatch, CARM R2 customs, and settlement workspaces require authorized staff credentials.
              </p>
              <a
                href="/login?next=%2Fops"
                class="inline-flex items-center gap-1.5 text-bro-gold hover:text-amber-300 font-medium transition-colors"
              >
                <span>Operations Portal (Staff Sign-In) →</span>
              </a>
            </div>
          )}
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 mt-10 pt-6 border-t border-white/[0.06] flex flex-col sm:flex-row justify-between items-center gap-3 text-[11px] text-slate-400">
        <span>© 2026 #BRO Transport Corp. All rights reserved.</span>
        <span class="font-mono">CBP ACE PAPS · CBSA ACI PARS · CARM Release 2 · ECDSA P-256</span>
      </div>
    </footer>
  </body>
</html>
