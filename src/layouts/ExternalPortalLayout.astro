---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import BroLogo from '../components/brand/BroLogo.astro';
import CommandPalette from '../components/nav/CommandPalette';

interface Props {
  title: string;
  portalType: 'shipper' | 'driver';
}

const { title, portalType } = Astro.props;
const user = Astro.locals.user;
const pathname = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#030307" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <title>{title} | #BRO External Portal</title>
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body class="bg-spatial-cosmos text-bro-ice min-h-screen flex flex-col selection:bg-bro-cyan/30">
    <header class="sticky top-3 z-40 px-3 sm:px-6 pointer-events-none">
      <div class="max-w-7xl mx-auto rounded-full liquid-glass px-4 sm:px-5 h-14 sm:h-16 flex items-center justify-between gap-4 pointer-events-auto">
        <div class="flex items-center gap-3">
          <a href="/" class="shrink-0">
            <BroLogo compact />
          </a>
          <span class={`hidden sm:inline-flex items-center px-3 py-1 rounded-full text-[11px] font-medium border ${
            portalType === 'driver'
              ? 'border-bro-gold/40 bg-bro-gold/10 text-bro-gold'
              : 'border-bro-cyan/40 bg-bro-cyan/10 text-bro-cyan'
          }`}>
            {portalType === 'driver' ? 'Driver Offline PWA' : 'Customer & Shipper Portal'}
          </span>
        </div>

        <div class="flex items-center gap-2.5">
          <CommandPalette client:load />
          <a
            href={portalType === 'driver' ? '/portal/shipper' : '/portal/driver'}
            class="hidden md:inline-flex text-xs font-medium text-slate-300 hover:text-white px-3 py-1.5 rounded-full border border-white/15 bg-white/[0.05] transition-colors"
          >
            {portalType === 'driver' ? 'Shipper View' : 'Driver View'}
          </a>
          {user && (
            <div class="flex items-center gap-2">
              <span class="hidden sm:inline text-xs font-medium text-slate-200">{user.name}</span>
              <form method="POST" action="/api/auth/logout">
                <button
                  type="submit"
                  class="px-3 py-1.5 rounded-full border border-white/15 hover:border-rose-400/60 text-xs font-medium text-slate-300 hover:text-rose-200 cursor-pointer transition-colors"
                >
                  Sign Out
                </button>
              </form>
            </div>
          )}
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 pt-8 pb-10">
      <slot />
    </main>

    <footer class="border-t border-white/[0.06] py-5 px-6 text-center text-xs text-slate-500">
      #BRO Transport Corp. External Partner Portal · <span class="font-mono">{pathname}</span>
    </footer>
  </body>
</html>
