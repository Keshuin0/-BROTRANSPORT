# Local Cloudflare Wrangler secrets (copy to .dev.vars — NEVER commit .dev.vars!)
ENVIRONMENT=development
PUBLIC_APP_URL=http://localhost:4321
SCAC_CODE=BROP

# Required in production (fail-closed)
BETTER_AUTH_SECRET=replace-with-32-byte-random-hex-secret
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret
RNS_WEBHOOK_SECRET=replace-with-hmac-sha256-rns-secret
EDI_WEBHOOK_SECRET=replace-with-hmac-sha256-edi-secret
TELEMATICS_WEBHOOK_SECRET=replace-with-hmac-sha256-telematics-secret

# Free / External Integrations
FMCSA_WEB_KEY=replace-with-free-login-gov-fmcsa-qcmobile-webkey
RESEND_API_KEY=replace-with-resend-api-key
STRIPE_SECRET_KEY=optional-stripe-secret-key
