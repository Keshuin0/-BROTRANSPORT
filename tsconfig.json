{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["src/*"],
      "@bro/contracts": ["packages/contracts/src/index.ts"],
      "@bro/db": ["packages/db/src/index.ts"]
    },
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "workers/**/*",
    "packages/**/*"
  ],
  "exclude": ["dist", "edge", "node_modules"]
}
